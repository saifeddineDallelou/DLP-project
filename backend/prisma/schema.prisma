generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core models ─────────────────────────────────────────────────────────────

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  passwordHash     String                @map("password_hash")
  role             Role                  @default(ANALYST)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  auditLogs        AuditLog[]
  incidents        Incident[]            @relation("AssignedIncidents")

  @@map("users")
}

model Policy {
  id          String     @id @default(uuid())
  name        String
  description String?
  conditions  Json
  // The default response, used for any channel not named below.
  action      Action     @default(ALERT)
  // Per-channel overrides: { "FILE": "QUARANTINE", "CLIPBOARD": "BLOCK" }.
  //
  // The right action depends on the CHANNEL, not only on the data. A paste,
  // a drag or a file-picker selection is an action in flight and can be
  // stopped; a file sitting in a watched folder is not doing anything, so
  // there is nothing to intercept and the only real response is to move it.
  //
  // Without this, BLOCK on a file at rest silently did nothing but write an
  // incident -- identical to ALERT -- while the log claimed action=BLOCK.
  // Purview and Netskope model the same way: one policy for what is
  // sensitive, then a response per location.
  channelActions Json?   @map("channel_actions")
  severity    Severity   @default(MEDIUM)
  enabled     Boolean    @default(true)
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  incidents   Incident[]
  aiLeakAttempts AiLeakAttempt[]

  @@map("policies")
}

// Admin-configurable "restricted apps" list -- matched against a foreground
// window title / process name the same way the AI-platform table is, but
// the presence of a restricted app is NOT itself a violation (the app runs
// normally otherwise): it only matters as an additional risky-destination
// signal when sensitive content is about to touch it (clipboard copy, file
// pick, ...), mirroring Microsoft Purview Endpoint DLP's "Restricted apps"
// list, which likewise never blocks the app from launching -- only from
// accessing a DLP-protected file.
model AppRule {
  id        String   @id @default(uuid())
  keyword   String   @unique
  label     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_rules")
}

model Agent {
  id             String          @id @default(uuid())
  hostname       String          @unique
  os             String
  version        String          @default("1.0.0")
  status         AgentStatus     @default(ACTIVE)
  lastSeen       DateTime?       @map("last_seen")
  token          String          @unique
  createdAt      DateTime        @default(now()) @map("created_at")
  incidents      Incident[]
  behaviorEvents BehaviorEvent[]
  aiLeakAttempts AiLeakAttempt[]

  @@map("agents")
}

model Incident {
  id           String         @id @default(uuid())
  agentId      String         @map("agent_id")
  policyId     String         @map("policy_id")
  severity     Severity       @default(MEDIUM)
  channel      Channel
  status       IncidentStatus @default(OPEN)
  evidence     Bytes?
  evidenceType String?        @map("evidence_type")
  riskScore    Float?         @map("risk_score")
  assignedToId String?        @map("assigned_to_id")
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  // The block is silent for the end user -- no popup lets them self-restore
  // the content. They can only flag the block for an admin to look at, with
  // an optional short note explaining why (reviewRequested/justification).
  // The admin's own explanation after reviewing goes in adminNote -- a
  // separate field because it's a different author and a different purpose
  // (the worker explains their intent in the moment; the admin records the
  // disposition after investigating).
  reviewRequested Boolean @default(false) @map("review_requested")
  justification   String?
  adminNote       String? @map("admin_note")

  agent      Agent  @relation(fields: [agentId], references: [id])
  policy     Policy @relation(fields: [policyId], references: [id])
  assignedTo User?  @relation("AssignedIncidents", fields: [assignedToId], references: [id])

  @@map("incidents")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── UEBA models ─────────────────────────────────────────────────────────────

model UserBehaviorBaseline {
  id                   String   @id @default(uuid())
  // Free string, NOT a foreign key to User -- this identifies the MONITORED
  // person (whatever identity the agent reports for BehaviorEvent.userId,
  // e.g. a Windows username), which is a different identity space from
  // User.id (a dashboard login account). A SOC analyst's dashboard account
  // and the employees they monitor are typically different people.
  userId               String   @unique @map("user_id")
  // Peer group for relative scoring. Nullable because the agent reports a
  // Windows username and has no idea what team that person is on -- it is
  // admin-declared, not discovered. A user with no department is scored
  // self-relative only, which is exactly the behaviour before this field
  // existed, so an unpopulated deployment degrades rather than breaks.
  department           String?
  avgDailyFiles        Float    @map("avg_daily_files")
  avgDailyVolumeMB     Float    @map("avg_daily_volume_mb")
  avgWorkingHourStart  Int      @map("avg_working_hour_start")
  avgWorkingHourEnd    Int      @map("avg_working_hour_end")
  avgUsbFrequency      Float    @map("avg_usb_frequency")
  // How many DISTINCT DAYS of activity this baseline was computed from.
  //
  // Without it, a baseline built from three events in one lunchtime is
  // presented with exactly the confidence of one built from three weeks of
  // work, and the scorer trusts it identically. That is not a hypothetical:
  // a freshly deployed agent produces a window like "12-12h" -- this person
  // works one hour a day -- against which every ordinary morning reads as
  // after-hours, and an entire rollout flags on day two.
  //
  // 0 is the honest value for a baseline written before this field existed:
  // we do not know what it rests on, so it is not yet trusted for scoring.
  activeDaysObserved   Int      @default(0) @map("active_days_observed")
  riskScore            Float    @default(0) @map("risk_score")
  lastUpdated          DateTime @map("last_updated")

  @@map("user_behavior_baselines")
}

model BehaviorEvent {
  id        String            @id @default(uuid())
  agentId   String            @map("agent_id")
  userId    String            @map("user_id")
  eventType BehaviorEventType @map("event_type")
  metadata  Json
  timestamp DateTime          @default(now())

  agent Agent @relation(fields: [agentId], references: [id])

  @@map("behavior_events")
}

// ─── AI-leak models ───────────────────────────────────────────────────────────

model AiLeakAttempt {
  id            String    @id @default(uuid())
  agentId       String    @map("agent_id")
  policyId      String?   @map("policy_id")
  platform      AiPlatform
  method        LeakMethod
  contentSample String?   @map("content_sample")
  riskScore     Float     @map("risk_score")
  blocked       Boolean   @default(true)
  timestamp     DateTime  @default(now())
  // How many times this same attempt was made inside one reporting window.
  // A single row with attempts=23 says "someone tried 23 times" -- twenty
  // three near-identical rows say the same thing far less clearly, and one
  // row saying 1 (which is what a per-window throttle produced) actively
  // misleads: it reads as a one-off accident.
  attempts      Int       @default(1)
  lastAttemptAt DateTime? @map("last_attempt_at")
  // See the matching fields on Incident for the reasoning.
  reviewRequested Boolean @default(false) @map("review_requested")
  justification   String?
  adminNote       String? @map("admin_note")

  agent  Agent   @relation(fields: [agentId], references: [id])
  policy Policy? @relation(fields: [policyId], references: [id])

  @@map("ai_leak_attempts")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Action {
  ALLOW
  ALERT
  BLOCK
  QUARANTINE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  FALSE_POSITIVE
}

enum Channel {
  FILE
  CLIPBOARD
  USB
  PRINT
  SCREENSHOT
  NETWORK
}

enum BehaviorEventType {
  FILE_ACCESS
  USB_INSERT
  CLIPBOARD_COPY
  SCREENSHOT
  APP_LAUNCH
  AFTER_HOURS_ACCESS
  LARGE_FILE_TRANSFER
}

enum AiPlatform {
  OPENAI_CHATGPT
  ANTHROPIC_CLAUDE
  GOOGLE_GEMINI
  MICROSOFT_COPILOT
  PERPLEXITY
  POE
  CHARACTER_AI
  MISTRAL
  GROK
  META_AI
  DEEPSEEK
  HUGGINGFACE
  YOU_COM
  PI_AI
  GROQ
  COHERE
  OTHER_AI
}

enum LeakMethod {
  CLIPBOARD
  SCREENSHOT
  BROWSER
  EXTENSION
}
