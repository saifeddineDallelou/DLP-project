DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dlp_db"
JWT_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CLASSIFIER_URL=http://127.0.0.1:8000
EVIDENCE_ENCRYPTION_KEY="replace-with-a-32-char-key"

# UEBA baseline auto-refresh (see src/lib/baseline-refresh.js)
BASELINE_REFRESH_INTERVAL_MINUTES=60
BASELINE_STALE_HOURS=24
BASELINE_WINDOW_DAYS=30

# SIEM forwarding (see src/lib/siem.js). "off" | "webhook" | "syslog"
SIEM_MODE=off
# webhook mode
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_AUTH=
# syslog mode (RFC 5424)
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTOCOL=udp
SIEM_TIMEOUT_MS=5000
SIEM_HOSTNAME=dlp-platform
