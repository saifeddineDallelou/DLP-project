# Dependencies
node_modules/
.venv/
venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# Agent runtime state (contains live enrollment token)
agent/state.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Personal scratch/prep files (not project code)
.scratch/

# EDM reference sets — salted digests of an organisation's real records.
# Not raw data, but deployment state, and never something to commit.
classifier/edm_store/

# Browser-extension packaging artefacts.
#
# "Pack extension" produces a .crx and a .pem. The .pem is the PRIVATE KEY
# that signs the extension's identity: anyone holding it can publish an
# update that browsers accept as genuinely yours. It is never committed, and
# it is not needed to develop -- "Load unpacked" runs the folder directly.
*.crx
*.pem
